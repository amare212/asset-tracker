# Copy this file to ".env" (cp .env.example .env) and change the values.
# ".env" is git-ignored so real secrets never get committed.

POSTGRES_DB=assetdb
POSTGRES_USER=asset_user
POSTGRES_PASSWORD=change_me_db_password

# must be at least 32 characters
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# first ADMIN account, created automatically on startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
